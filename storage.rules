rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedInAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && firestore.exists(/databases/(default)/documents/admin_users/$(request.auth.token.email.lower()));
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('image/.*');
    }

    match /security/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedInAdmin() && isImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
